# ─── Thread / OpenThread ─────────────────────────────────────────────────────
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_COMMISSIONER=n
CONFIG_OPENTHREAD_JOINER=n
# OpenThread allocates its message-buffer pool from the heap at init (before BLE
# comes up), so it directly squeezes Bluedroid. The default (65) is generous for
# a low-traffic device; 20 frees several KB. Raise if Thread drops packets.
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=20

# ─── IEEE 802.15.4 radio (ESP32-H2 native) ───────────────────────────────────
CONFIG_IEEE802154_ENABLED=y

# ─── Bluetooth LE — required for Matter commissioning (HomeKit pairs over BLE) ─
# Bluedroid host, BLE-only. Trimmed hard for the RAM-constrained H2: Bluedroid's
# init env-malloc was failing ("Bluedroid Initialize Fail") with only ~52 KB
# heap free after OpenThread comes up. A Matter device only ever needs ONE BLE
# link (commissioning), so 1 ACL connection; the BTC task stack is cut from the
# reference's very generous 15000 (frees heap — it's heap-allocated at init).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_BTC_TASK_STACK_SIZE=8192
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# ─── Thread + BLE coexistence (concurrent commissioning) ─────────────────────
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ─── Partition table — Matter+Thread+BLE image is large (~2 MB) ───────────────
# 3 MB factory app + 24 KB NVS (Matter fabric/ACL persistence). Needs 4 MB flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
# NOTE: must be ABSOLUTE. esp-idf-sys sets the CMake PROJECT_DIR to its own
# generated build dir, so a relative path resolves there (not this crate root)
# and the partition tool can't find the file. This absolute path is the one
# machine-specific line in this config — update it if the repo moves.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/Users/yan/dev/rust/esppower1/rcd-reset-controller/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ─── NVS (Non-Volatile Storage) — persists Matter fabric + commissioner data ──
CONFIG_NVS_FLASH_PARTITION_SIZE=0x6000

# ─── ADC ─────────────────────────────────────────────────────────────────────
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y

# ─── LEDC (LED PWM controller — used for RC servo signal) ───────────────────
# The clock source is chosen at runtime via LEDC_AUTO_CLK (esp-idf-hal). On the
# ESP32-H2 there is no LEDC APB clock anyway — only XTAL / PLL_F96M / RC_FAST —
# so there is nothing to set here. (CONFIG_LEDC_USE_APB_CLK is not a real symbol
# and was silently dropped.)

# ─── FreeRTOS / System ───────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# Larger system/idle stacks — rs-matter + OpenThread callbacks need headroom.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# ─── Logging ─────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# System (not RTOS-tick) timestamps + colors so the printed QR code is not
# distorted by misaligned log prefixes.
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
CONFIG_LOG_COLORS=y

# ─── Stack sizes ─────────────────────────────────────────────────────────────
# The main task runs only the lightweight RCD controller loop (ADC sampling +
# embassy timers), so 8 KB is ample — and the main task stack is heap-allocated,
# so this frees ~8 KB toward Bluedroid's init. (The Matter stack runs on its own
# 20 KB thread, untouched.)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
